{
  "archivo": "PopTemplate",
  "prefijo": "pop",
  "mote": "Pop",
  "titulo": "POP",
  "varianteBase": "Fucsia",
  "resumen": [
    "El cómic: Bangers en mayúsculas sobre negro, Nunito para el texto y tres",
    "colores que se pisan entre sí. Los títulos llevan contorno, como un",
    "globo de diálogo."
  ],
  "serif": {
    "modulo": "Bangers",
    "css": "'Bangers', cursive",
    "pesos": [
      "400"
    ]
  },
  "sans": {
    "modulo": "Nunito",
    "css": "'Nunito', sans-serif",
    "pesos": [
      "400",
      "500",
      "700"
    ]
  },
  "mono": {
    "modulo": "Nunito",
    "css": "'Nunito', sans-serif",
    "pesos": [
      "400",
      "500",
      "700"
    ]
  },
  "paleta": {
    "bg": "#0E0E10",
    "bg2": "#FFF4E0",
    "ink": "#FFF4E0",
    "ink2": "#B8AE9C",
    "acc": "#FF2E63",
    "acc2": "#FFD84D"
  },
  "cssExtra": [
    "/* Pop: el titular tiene contorno y sombra dura, como una viñeta. */",
    ".pop-cartel-nombres, .pop-h2 { letter-spacing: .02em; -webkit-text-stroke: 2px var(--pp-ink); text-shadow: 4px 4px 0 var(--pp-acc); }",
    ".pop-trama { opacity: .18; background-size: 8px 8px; }"
  ],
  "variantes": {
    "Limon": {
      "etiqueta": "Limón",
      "bg": "#0E0E10",
      "bg2": "#FFF7E6",
      "ink": "#FFF7E6",
      "ink2": "#B9B39F",
      "acc": "#FFD84D",
      "acc2": "#2EC4FF"
    },
    "Cian": {
      "etiqueta": "Cian",
      "bg": "#0E0E10",
      "bg2": "#F0FAFF",
      "ink": "#F0FAFF",
      "ink2": "#A9B7BF",
      "acc": "#2EC4FF",
      "acc2": "#FF2E63"
    },
    "Lila": {
      "etiqueta": "Lila",
      "bg": "#0E0E10",
      "bg2": "#F7F0FF",
      "ink": "#F7F0FF",
      "ink2": "#B5A9C4",
      "acc": "#B455FF",
      "acc2": "#FFD84D"
    },
    "Naranja": {
      "etiqueta": "Naranja",
      "bg": "#0E0E10",
      "bg2": "#FFF3E8",
      "ink": "#FFF3E8",
      "ink2": "#BFAE9F",
      "acc": "#FF7A1A",
      "acc2": "#3DF2B0"
    }
  }
}
