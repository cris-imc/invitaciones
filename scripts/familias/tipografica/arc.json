{
  "archivo": "ArcadeTemplate",
  "prefijo": "arc",
  "mote": "Arcade",
  "titulo": "ARCADE",
  "varianteBase": "Neón",
  "resumen": [
    "La maquinita: Press Start 2P para los titulares (píxel puro), Rubik para",
    "el texto -- que en píxel sería ilegible -- y la paleta de un salón de",
    "juegos. Sombras duras, sin una sola curva."
  ],
  "serif": {
    "modulo": "Press_Start_2P",
    "css": "'Press Start 2P', cursive",
    "pesos": [
      "400"
    ]
  },
  "sans": {
    "modulo": "Rubik",
    "css": "'Rubik', sans-serif",
    "pesos": [
      "400",
      "500"
    ]
  },
  "mono": {
    "modulo": "Rubik",
    "css": "'Rubik', sans-serif",
    "pesos": [
      "400",
      "500"
    ]
  },
  "paleta": {
    "bg": "#12082B",
    "bg2": "#1E0F45",
    "ink": "#FFFFFF",
    "ink2": "#FFFFFF",
    "acc": "#FF3CAC",
    "acc2": "#3DF5FF"
  },
  "cssExtra": [
    "/* Arcade: píxel. Press Start 2P es mucho más ancha que una serif, así que",
    "   los titulares bajan de tamaño y suben de interlínea; la sombra es doble",
    "   y dura, y la trama son scanlines. */",
    ".arc-tapa-nombres { font-size: min(clamp(20px, 6.5vw, 40px), 8vh); line-height: 1.35; letter-spacing: 0; }",
    ".arc-h2, .arc-frase, .arc-panel-titulo { font-size: clamp(18px, 5vw, 32px); line-height: 1.45; letter-spacing: 0; }",
    ".arc-fecha-linea { font-size: clamp(30px, 11vw, 78px); line-height: 1.1; }",
    ".arc-cuenta-num, .arc-cuenta-dias, .arc-cifra { font-size: clamp(26px, 8vw, 56px); line-height: 1.2; }",
    ".arc-tapa-nombres, .arc-h2, .arc-panel-titulo { text-shadow: 3px 3px 0 var(--pp-acc), 6px 6px 0 var(--pp-acc2); }",
    ".arc-trama { opacity: .12; background-image: linear-gradient(currentColor 1px, transparent 1px); background-size: 100% 4px; }"
  ],
  "variantes": {
    "Pacman": {
      "etiqueta": "Pac",
      "bg": "#0B0B14",
      "bg2": "#16162A",
      "ink": "#FFFFFF",
      "ink2": "#FFFFFF",
      "acc": "#FF5E5B",
      "acc2": "#5BC0FF"
    },
    "Vapor": {
      "etiqueta": "Vapor",
      "bg": "#1B0F3A",
      "bg2": "#2A1A55",
      "ink": "#FFFFFF",
      "ink2": "#FFFFFF",
      "acc": "#FF71CE",
      "acc2": "#01CDFE"
    },
    "Gameboy": {
      "etiqueta": "Game Boy",
      "bg": "#0F380F",
      "bg2": "#306230",
      "ink": "#E0F8D0",
      "ink2": "#E0F8D0",
      "acc": "#9BBC0F",
      "acc2": "#8BAC0F"
    },
    "Candy": {
      "etiqueta": "Candy",
      "bg": "#2B0A2E",
      "bg2": "#421346",
      "ink": "#FFFFFF",
      "ink2": "#FFFFFF",
      "acc": "#FF8FCF",
      "acc2": "#7CF5E1"
    }
  }
}
