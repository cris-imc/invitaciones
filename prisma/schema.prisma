generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  emailVerified         DateTime?
  password              String?
  mustChangePassword    Boolean      @default(false)
  name                  String
  image                 String?
  role                  String       @default("CLIENT")
  planTier              String       @default("FREE")
  subscriptionStatus    String       @default("TRIAL")
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  premiumCredits        Int          @default(0)
  diamondCredits        Int          @default(0)
  phoneAreaCode         String?
  phoneNumber           String?
  mercadoPagoCustomerId String?      @unique
  termsAcceptedAt       DateTime?
  termsAcceptedIp       String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  accounts              Account[]
  invitations           Invitation[]
  payments              Payment[]
  sessions              Session[]
  loginEvents           LoginEvent[]
  passwordResetTokens   PasswordResetToken[]
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // Nunca se guarda el token en texto plano -- si se filtra la base, un
  // token robado no alcanza para resetear ninguna contraseña sin también
  // conocer el valor original (el mismo criterio que ya se usa con
  // User.password vía bcrypt).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  amount         Float
  currency       String        @default("ARS")
  status         String
  paymentMethod  String?
  planTier       String
  mercadoPagoId  String?       @unique
  createdAt      DateTime      @default(now())
  discountCodeId String?
  discountAmount Float?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([discountCodeId])
}

// Codigos de descuento configurables por el admin (/dashboard/descuentos):
// un codigo = un porcentaje extra sobre el precio ya vigente del plan
// (incluido el 20% base de Diamond), reutilizable mientras enabled=true.
// Sin limite de usos, sin expiracion, sin edicion de porcentaje -- si un
// codigo quedo mal, se deshabilita y se crea uno nuevo (mantiene el
// historial de Payment.discountAmount consistente).
model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  percentage Int
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]
}

model Invitation {
  id                           String           @id @default(cuid())
  userId                       String
  planTier                     String           @default("FREE")
  premiumCreditSpent           Boolean          @default(false)
  diamondCreditSpent           Boolean          @default(false)
  maxGuestsOverride            Int?
  // Superpoder de admin: sube (o baja) el tope de fotos guardadas en LIVE de
  // ESTA tarjeta puntual, sin tocar el limite del plan (200 en Diamond) que
  // siguen teniendo el resto de las tarjetas/clientes. null = usa el limite
  // del plan tal cual.
  maxLivePhotosOverride        Int?
  // Saludo de la portada en los links personalizados: true (default, se
  // mantiene el comportamiento actual) = muestra el nombre del invitado o
  // familia; false = muestra siempre el nombre de los novios/quinceañera/
  // evento aunque el link sea personalizado. Configuración genérica del
  // dueño de la tarjeta, no por invitado individual.
  mostrarNombreInvitadoEnSaludo Boolean          @default(true)
  tipo                         String
  estado                       String           @default("BORRADOR")
  slug                         String           @unique
  nombreEvento                 String
  fechaEvento                  DateTime
  nombreNovio                  String?
  nombreNovia                  String?
  nombreQuinceanera            String?
  lugarNombre                  String?
  direccion                    String?
  hora                         String?
  mapUrl                       String?
  templateId                   String
  templateTipo                 String           @default("ORIGINAL")
  temaColores                  String
  imagenCelebremosJuntos       String?
  cronogramaEventos            String?
  musicaUrl                    String?
  portadaHabilitada            Boolean          @default(true)
  portadaTitulo                String?
  portadaDressCode             String?
  portadaTextoBoton            String?
  portadaImagenFondo           String?
  portadaImagenFondoDesktop    String?
  portadaImagenPosX            Int              @default(50)
  portadaImagenPosY            Int              @default(50)
  portadaImagenEscala          Int              @default(100)
  portadaImagenDesktopPosX     Int              @default(50)
  portadaImagenDesktopPosY     Int              @default(50)
  portadaImagenDesktopEscala   Int              @default(100)
  musicaHabilitada             Boolean          @default(true)
  musicaAutoplay               Boolean          @default(true)
  musicaLoop                   Boolean          @default(true)
  contadorHabilitado           Boolean          @default(true)
  seccionCuandoHabilitada      Boolean          @default(true)
  seccionCuandoIcono           String?
  seccionCuandoTitulo          String?
  seccionDondeHabilitada       Boolean          @default(true)
  seccionDondeIcono            String?
  seccionDondeTitulo           String?
  lugarBotonTexto              String?
  ceremoniaHabilitada          Boolean          @default(false)
  ceremoniaTitulo              String?
  ceremoniaNombre              String?
  ceremoniaDireccion           String?
  ceremoniaHora                String?
  ceremoniaMapUrl              String?
  dresscodeHabilitado          Boolean          @default(false)
  dresscodeIcono               String?
  dresscodeTitulo              String?
  dresscodeTipo                String?
  dresscodeObservaciones       String?
  galeriaPrincipalHabilitada   Boolean          @default(true)
  galeriaPrincipalFotos        String?
  galeriaPrincipalEstilo       String?
  galeriaPrincipalAutoplay     Boolean          @default(false)
  frasePersonalizadaHabilitada Boolean          @default(false)
  frasePersonalizadaTexto      String?
  frasePersonalizadaEstilo     String?
  albumCompartidoHabilitado    Boolean          @default(true)
  albumCompartidoIcono         String?
  albumCompartidoTitulo        String?
  albumCompartidoDescripcion   String?
  albumCompartidoBotonTexto    String?
  sugerenciaMusicaHabilitada   Boolean          @default(true)
  regaloHabilitado             Boolean          @default(false)
  regaloIcono                  String?
  regaloTitulo                 String?
  regaloMensaje                String?
  regaloMostrarDatos           Boolean          @default(false)
  regaloAlias                  String?
  regaloCvu                    String?
  regaloCbu                    String?
  regaloBanco                  String?
  regaloTitular                String?
  regaloMonto                  Float?
  regaloMontoUpdatedAt         DateTime?
  pagoTarjetaHabilitado        Boolean          @default(false)
  pagoTarjetaTitulo            String?
  pagoTarjetaMensaje           String?
  pagoTarjetaMostrarDatos      Boolean          @default(false)
  pagoTarjetaAlias             String?
  pagoTarjetaCbu               String?
  pagoTarjetaBanco             String?
  pagoTarjetaTitular           String?
  pagoTarjetaMonto             Float?
  precioNino                   Float?
  precioAdolescente            Float?
  precioNinoHabilitado         Boolean          @default(true)
  precioAdolescenteHabilitado  Boolean          @default(false)
  galeriaSecundariaHabilitada  Boolean          @default(false)
  galeriaSecundariaFotos       String?
  mensajeFinalHabilitado       Boolean          @default(false)
  mensajeFinalTexto            String?
  triviaHabilitada             Boolean          @default(false)
  triviaIcono                  String?
  triviaTitulo                 String?
  triviaSubtitulo              String?
  triviaPreguntas              String?
  triviaBotonTexto             String?
  infoAdicionalSeccionHabilitada Boolean        @default(false)
  infoAlojamientoHabilitado    Boolean          @default(false)
  infoAlojamientoTexto         String?
  infoEstacionamientoHabilitado Boolean         @default(false)
  infoEstacionamientoTexto     String?
  infoTransporteHabilitado     Boolean          @default(false)
  infoTransporteTexto          String?
  infoAdicionalHabilitado      Boolean          @default(false)
  infoAdicionalTexto           String?
  rsvpEnabled                  Boolean          @default(true)
  rsvpType                     String?          @default("INDIVIDUAL")
  rsvpDeadline                 DateTime?
  rsvpDaysBeforeEvent          Int?             @default(7)
  confirmacionHabilitada       Boolean          @default(true)
  confirmacionIcono            String?
  confirmacionTitulo           String?
  confirmacionFechaLimite      DateTime?
  confirmacionWhatsapp         String?
  confirmacionEmail            String?
  despedidaHabilitada          Boolean          @default(false)
  despedidaIcono               String?
  despedidaTexto               String?
  despedidaFoto                String?
  tipografiaDisplay            String?          @default("fraunces")
  fontTitle                    String?          @default("fraunces")
  fontBody                     String?          @default("space-grotesk")
  countdownStyle               String?          @default("clasico")
  albumStyle                   String?          @default("carrusel")
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  ciudad                       String?
  portadaKicker                String?
  portadaMensaje               String?
  album                        Album?
  cuestionario                 Cuestionario?
  guests                       Guest[]
  user                         User             @relation(fields: [userId], references: [id])
  rsvps                        RSVP[]
  songSuggestions              SongSuggestion[]
  liveSession                  LiveSession?
}

model Guest {
  id                     String           @id @default(cuid())
  invitationId           String
  name                   String
  type                   String           @default("INDIVIDUAL")
  expectedCount          Int              @default(1)
  expectedAdults         Int?
  expectedTeens          Int?
  expectedChildren       Int?
  uniqueToken            String           @unique
  status                 String           @default("PENDING")
  attendingCount         Int              @default(0)
  attendingAdults        Int              @default(0)
  attendingTeens         Int              @default(0)
  attendingChildren      Int              @default(0)
  isExempt               Boolean          @default(false)
  // Pago de tarjeta por CUPO. En vez de llevar un monto suelto, se lleva cuantos
  // lugares de cada franja estan saldados y cuanta plata entro por ellos.
  //
  // Los montos son historia: se acumulan al precio que regia cuando se marco el
  // cupo y no se recalculan nunca ("lo que se pago queda pagado"). Los cupos que
  // siguen pendientes se valuan al precio vigente, asi que un aumento posterior
  // solo los alcanza a ellos. Ver src/lib/card-payments.ts.
  paidAdults             Int              @default(0)
  paidTeens              Int              @default(0)
  paidChildren           Int              @default(0)
  paidAmountAdults       Float            @default(0)
  paidAmountTeens        Float            @default(0)
  paidAmountChildren     Float            @default(0)
  // Plata que el anfitrion dice haber recibido, para su propio control. Es
  // independiente de los cupos marcados: si una familia de 4 paga dos tarjetas
  // pero entrega de mas, aca queda el monto real y la diferencia se muestra como
  // saldo a cuenta de pagos futuros. No participa de ningun calculo de estado.
  receivedAmount         Float            @default(0)
  message                String?
  responseDate           DateTime?
  dietaryRestrictions    String?
  paymentStatus          String           @default("PENDING")
  paymentStatusUpdatedAt DateTime?
  paymentStatusUpdatedBy String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  invitation             Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  songSuggestions        SongSuggestion[]

  @@index([invitationId])
  @@index([uniqueToken])
}

model Album {
  id             String     @id @default(cuid())
  invitationId   String     @unique
  permitirSubida Boolean    @default(true)
  moderacion     Boolean    @default(false)
  invitation     Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  fotos          Foto[]
}

model Foto {
  id          String   @id @default(cuid())
  albumId     String
  url         String
  descripcion String?
  uploadedBy  String
  aprobada    Boolean  @default(true)
  createdAt   DateTime @default(now())
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model RSVP {
  id                 String     @id @default(cuid())
  invitationId       String
  nombre             String
  email              String?
  telefono           String?
  asistencia         String
  numeroAcompanantes Int        @default(0)
  restricciones      String?
  mensaje            String?
  createdAt          DateTime   @default(now())
  invitation         Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model Cuestionario {
  id           String     @id @default(cuid())
  invitationId String     @unique
  titulo       String
  preguntas    String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model QuizResponse {
  id             String   @id @default(cuid())
  invitationId   String
  guestName      String
  guestToken     String?
  answers        String
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  @@index([invitationId])
  @@index([guestToken])
}

model SongSuggestion {
  id           String     @id @default(cuid())
  invitationId String
  guestId      String?
  guestToken   String?
  guestName    String
  title        String
  artist       String
  votes        Int        @default(0)
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  guest        Guest?     @relation(fields: [guestId], references: [id])
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([invitationId, status])
}

model LiveSession {
  id              String                 @id @default(cuid())
  invitationId    String                 @unique
  publicToken     String                 @unique
  isActive        Boolean                @default(true)
  isModerated     Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  invitation      Invitation             @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  items           LiveItem[]
  termsAcceptances LiveTermsAcceptance[]
}

// Prueba server-side de que un invitado aceptó los Términos y Condiciones
// del servicio LIVE antes de poder subir contenido -- el checkbox del
// cliente por sí solo no alcanza como evidencia, así que cada aceptación
// exitosa queda registrada acá (con IP y user-agent) y el endpoint de
// upload exige un acceptanceId válido para procesar cualquier archivo.
model LiveTermsAcceptance {
  id         String      @id @default(cuid())
  sessionId  String
  guestName  String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime    @default(now())
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items      LiveItem[]

  @@index([sessionId])
}

model LiveItem {
  id           String                @id @default(cuid())
  sessionId    String
  type         String                // "PHOTO" | "AUDIO"
  fileUrl      String
  duration     Int?                  // Solo para AUDIO, en segundos
  guestName    String?               // Opcional
  isActive     Boolean               @default(true) // true = aprobado, visible en pantalla/publico
  status       String                @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED"
  rejectedAt   DateTime?             // cuando se rechazo -- se borra 1h despues (limpieza en GET /api/live/session)
  createdAt    DateTime              @default(now())
  session      LiveSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  acceptanceId String?               // Trazabilidad: qué aceptación de T&C autorizó este item puntual
  acceptance   LiveTermsAcceptance?  @relation(fields: [acceptanceId], references: [id])

  @@index([sessionId, isActive, createdAt(sort: Desc)])
  @@index([sessionId, status, createdAt(sort: Desc)])
}
